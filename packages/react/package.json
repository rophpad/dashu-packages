{
  "name": "@rophpad/dashu-react",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Themeable React renderer for the Dashu result contract, with component overrides for products that already have a design system.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:package": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:package": "npm run typecheck",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/"
  },
  "dependencies": {
    "@rophpad/dashu-core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "react-dom": "^19.0.0"
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rophpad/dashu.git",
    "directory": "packages/react"
  }
}
